{
  "name": "@pedro-liam/tweetcraft-client",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "preview": "npm run build && node scripts/preview.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run test:coverage && npm run build"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@vitest/coverage-v8": "^5.0.4",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0",
    "vitest": "^5.0.4",
    "happy-dom": "^20.0.0"
  }
}
